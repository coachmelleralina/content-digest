# Copy to .env and fill values. Never commit .env.
# These are also set as Vercel project env vars (server-side only).

# OpenRouter API key for the AI digest (ADR 004). Server-side only.
OPENROUTER_API_KEY=

# Optional model override (default: anthropic/claude-3.5-haiku — ADR 004).
# Free-tier keys (no credits) get HTTP 402 on paid models; use a :free model, e.g.:
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL=

# Postgres connection string (ADR 003). Use the provider's POOLED URL for serverless.
DATABASE_URL=
