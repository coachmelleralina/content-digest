{
  "version": 2,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python", "config": { "maxDuration": 300 } },
    { "src": "app/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/assets/(.*)", "dest": "/app/assets/$1" },
    { "src": "/favicon.svg", "dest": "/app/favicon.svg" },
    { "src": "/icons.svg", "dest": "/app/icons.svg" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/app/index.html" }
  ]
}
